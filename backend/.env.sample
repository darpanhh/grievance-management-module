# ---------------------------------------------------------------------------
# Grievance Management System - Backend Environment Sample
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#   cp .env.sample .env
#
# SECURITY WARNING: never commit your real `.env` file.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set USE_SQLITE=True to use the local SQLite file (backend/db.sqlite3).
# Leave False to connect to PostgreSQL.
USE_SQLITE=False

DB_NAME=gms_db
DB_USER=gms_user
DB_PASSWORD=gms_password
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Dev default writes emails to backend/sent_emails/ (no SMTP needed).
# For real emails, switch EMAIL_BACKEND and set your SMTP credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=backend/sent_emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=Grievance Management System <noreply@example.com>
BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Escalation Configuration
# ---------------------------------------------------------------------------
# Fractional values are supported (e.g. 0.0833 hours ≈ 5 minutes).
#
# Production:    ESCALATION_HOURS=72  ESCALATION_INTERVAL_MINUTES=60
# Testing (~5m): ESCALATION_HOURS=0.0833  ESCALATION_INTERVAL_MINUTES=1
ESCALATION_HOURS=72
ESCALATION_INTERVAL_MINUTES=60
